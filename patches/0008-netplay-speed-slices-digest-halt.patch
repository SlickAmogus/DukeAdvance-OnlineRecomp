+// State digests are taken of the whole serialized session every tick (about
+// 0.8 MiB with two consoles), so a byte-serial hash costs a millisecond or
+// more of each tick. This one runs four independent 64-bit lanes over 32-byte
+// blocks. It is streaming (update may be called with any split of the same
+// bytes and gives the same result), little-endian by definition on every
+// host, and identical across builds of the same version: peers only compare
+// digests made by the same build fingerprint.
+class StateHasher {
+public:
+    void update(std::span<const std::uint8_t> bytes) {
+        const std::uint8_t* p = bytes.data();
+        std::size_t n = bytes.size();
+        total_ += n;
+        if (fill_) {
+            const std::size_t take = std::min(n, sizeof(buf_) - fill_);
+            std::copy_n(p, take, buf_ + fill_);
+            fill_ += take; p += take; n -= take;
+            if (fill_ < sizeof(buf_)) return;
+            block(buf_);
+            fill_ = 0;
+        }
+        for (; n >= sizeof(buf_); p += sizeof(buf_), n -= sizeof(buf_)) block(p);
+        std::copy_n(p, n, buf_);
+        fill_ = n;
+    }
+    std::uint32_t finish() const {
+        std::uint64_t lane[4] = {lane_[0], lane_[1], lane_[2], lane_[3]};
+        if (fill_) {
+            std::uint8_t last[32] = {};
+            std::copy_n(buf_, fill_, last);
+            mix(lane, last);
+        }
+        std::uint64_t h = total_ * kP3;
+        for (int i = 0; i < 4; ++i) h = rotl(h ^ lane[i] * kP2, 27) * kP1 + kP4;
+        h ^= h >> 33; h *= kP2; h ^= h >> 29; h *= kP3; h ^= h >> 32;
+        return static_cast<std::uint32_t>(h);
+    }
+private:
+    static constexpr std::uint64_t kP1 = 0x9E3779B185EBCA87ull, kP2 = 0xC2B2AE3D27D4EB4Full,
+                                   kP3 = 0x165667B19E3779F9ull, kP4 = 0x85EBCA77C2B2AE63ull;
+    static std::uint64_t rotl(std::uint64_t v, int s) { return (v << s) | (v >> (64 - s)); }
+    static std::uint64_t load64(const std::uint8_t* p) {
+        std::uint64_t v = 0;
+        for (int i = 7; i >= 0; --i) v = (v << 8) | p[i];
+        return v;
+    }
+    static void mix(std::uint64_t* lane, const std::uint8_t* p) {
+        for (int i = 0; i < 4; ++i) lane[i] = rotl(lane[i] + load64(p + 8 * i) * kP2, 31) * kP1;
+    }
+    void block(const std::uint8_t* p) { mix(lane_, p); }
+    std::uint64_t lane_[4] = {kP1 + kP2, kP2, 0, 0 - kP1};
+    std::uint8_t buf_[32] = {};
+    std::size_t fill_ = 0;
+    std::uint64_t total_ = 0;
+};
+std::uint32_t digest_of(std::span<const std::uint8_t> bytes) {
+    StateHasher h;
+    h.update(bytes);
+    return h.finish();
+}
