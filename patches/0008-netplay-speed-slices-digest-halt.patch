+// g_runtime_ram_code_view returns for a fragment inside one RAM block);
+// everything else goes through the view.
+inline const uint8_t* ram_code_bytes(uint32_t base, uint32_t size) {
+    const uint32_t region = base >> 24;
+    if ((region == 2u || region == 3u) && g_runtime_ram_code_ram_view == g_runtime_ram_code_view) {
