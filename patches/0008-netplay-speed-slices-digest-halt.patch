 #include "runtime_arm.h"
-namespace gba { class GbaBus; }
+#include "gba_bus.h"
 namespace gbarecomp {
 // Classify only; never execute or interpret guest semantics. Unknown/device
 // accesses terminate a native slice before the instruction's effects begin.
-bool multiplayer_slice_safe(const gba::GbaBus&,const ArmCpuState&);
+bool multiplayer_slice_safe_full(const gba::GbaBus&,const ArmCpuState&);
+
+// Runs before every guest instruction of a link session, so the commonest
+// case is answered here without a call: Thumb code in cartridge ROM whose
+// opcode touches no memory (formats 1-5, branches, BL halves). Same answers
+// as multiplayer_slice_safe_full, which handles everything else.
+inline bool multiplayer_slice_safe(const gba::GbaBus& bus,const ArmCpuState& cpu) {
+    const std::uint32_t pc=cpu.R[15];
+    if ((cpu.cpsr&0x20u) && pc-0x08000000u<0x06000000u && !(pc&1u)) {
+        const std::uint32_t off=pc&0x01ffffffu;
+        const std::uint8_t* rom=bus.rom_ptr();
+        if (rom && off+2u<=bus.rom_size()) {
+            const std::uint32_t word=rom[off]|(std::uint32_t(rom[off+1])<<8);
+            if (word<0x4800u || word>=0xf000u || (word>>11)==0x1cu) return true;
+            if ((word>>12)==0xdu && (word&0x0f00u)<0x0e00u) return true;
+        }
+    } else if (!(cpu.cpsr&0x20u) && pc-0x03000000u<0x01000000u && !(pc&3u)) {
+        // ARM in IWRAM (rasterisers and other hot routines): branches and
+        // data processing (not halfword transfers, multiplies or SWP).
+        const std::uint8_t* p=bus.iwram_ptr()+(pc&0x7fffu);
+        const std::uint32_t word=p[0]|(std::uint32_t(p[1])<<8)|(std::uint32_t(p[2])<<16)|(std::uint32_t(p[3])<<24);
+        if ((word>>28)!=0xfu) {
+            const std::uint32_t cls=word&0x0e000000u;
+            if (cls==0x0a000000u || cls==0x02000000u) return true;
+            if (cls==0 && (word&0x90u)!=0x90u) return true;
+        }
+    }
+    return multiplayer_slice_safe_full(bus,cpu);
+}
 }
