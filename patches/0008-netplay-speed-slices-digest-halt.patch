+// Every GbaBus::set_rom runs this, and netplay rollback builds fresh buses
+// for each snapshot load: without a driver the CRC fallback walks the whole
+// ROM (tens of milliseconds for 8 MiB) every time. The cartridge image never
+// changes while it is loaded, so the result is kept per image.
 std::vector<Mp2kSig> mp2k_detect(const uint8_t* rom, std::size_t len) {
+    static std::mutex lock;
+    static const uint8_t* cached_rom = nullptr;
+    static std::size_t cached_len = 0;
+    static std::vector<Mp2kSig> cached;
+    std::lock_guard<std::mutex> guard(lock);
+    if (!rom || rom != cached_rom || len != cached_len) {
+        cached = mp2k_scan(rom, len);
+        cached_rom = rom;
+        cached_len = len;
+    }
+    return cached;
+}
+
